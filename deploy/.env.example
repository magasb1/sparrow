# Copy to .env and fill in. docker compose refuses to start while a password is empty.
# (Coolify deployments use docker-compose.coolify.yml and need no .env: see that file.)

# Letters and digits only: it is put into a database URL.
POSTGRES_PASSWORD=

SPARROW_ADMIN_USER=admin
# At least 8 characters.
SPARROW_ADMIN_PASSWORD=

# Address phones use to reach this server. Empty = the address your browser used.
SPARROW_PUBLIC_URL=https://192.168.1.10:8443
# Names and IPs for the self-signed certificate, comma separated.
SPARROW_TLS_HOSTS=192.168.1.10
